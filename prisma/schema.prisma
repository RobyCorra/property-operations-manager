generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                        String       @id @default(cuid())
  name                      String
  slug                      String       @unique
  logoUrl                   String?
  legalName                 String?
  vatNumber                 String?
  fiscalCode                String?
  address                   String?
  city                      String?
  zip                       String?
  country                   String?
  phone                     String?
  email                     String?
  pec                       String?
  sdiCode                   String?
  aiMonthlyTokenLimit       Int          @default(1800000)
  aiTokensUsed              Int          @default(0)
  aiTokensResetAt           DateTime?
  perplexityMonthlyLimit      Int        @default(600)
  perplexityRequestsUsed      Int        @default(0)
  perplexityRequestsResetAt   DateTime?
  conflictMaxCleaningsPerDay  Int        @default(3)
  conflictUrgentHours         Int        @default(48)
  conflictStaleTicketDays     Int        @default(7)
  conflictOverlapMinutes      Int        @default(90)
  createdAt                   DateTime   @default(now())
  users        User[]
  apartments   Apartment[]
  properties   Property[]
  chatSessions   ManagerChatSession[]
  engagements    Engagement[]
  companyMessages OrgCompanyMessage[]
}

// Struttura ricettiva (hotel/residence): indirizzo unico, contiene N unita'
// raggruppate per categoria. L'appartamento singolo NON usa questo modello
// (resta un Apartment senza propertyId), cosi' i due tipi convivono.
model Property {
  id             String         @id @default(uuid())
  name           String
  organizationId String?
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  address        String
  latitude       Float
  longitude      Float
  type           String         @default("RESIDENCE") // "HOTEL" | "RESIDENCE"
  createdAt      DateTime       @default(now())
  categories     UnitCategory[]
  units          Apartment[]
  products       PropertyProduct[]

  @@index([organizationId])
}

// Prodotto a livello di struttura: stock UNICO condiviso da tutte le unita'.
// Il consumo al check-in viene definito per categoria (UnitCategory.consumption)
// e sottratto da questo stock.
model PropertyProduct {
  id         String                   @id @default(uuid())
  propertyId String
  property   Property                 @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name       String
  emoji      String                   @default("📦")
  unit       String                   @default("pz")
  stock      Int                      @default(0)
  minStock   Int                      @default(0)
  price      Float                    @default(0)
  vat        Float                    @default(22)
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt
  movements  PropertyStockMovement[]

  @@index([propertyId])
}

model PropertyStockMovement {
  id                String          @id @default(uuid())
  productId         String
  product           PropertyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  delta             Int
  balance           Int
  reason            String          // INITIAL | CHECKIN | RESTOCK | ADJUSTMENT
  bookingId         String?
  note              String?
  createdAt         DateTime        @default(now())

  @@index([productId, createdAt])
}

// Categoria di unita' = "master": le caratteristiche condivise da tutte le
// unita' che vi appartengono (mq, letti/biancheria, elettrodomestici, accessi).
// Le unita' sono identiche al master; modificando il master si propaga a tutte
// (con conferma esplicita lato UI).
model UnitCategory {
  id               String      @id @default(uuid())
  propertyId       String
  property         Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name             String
  squareMeters     Int
  bedrooms         Int
  bathrooms        Int
  maxGuests        Int
  bedConfig        Json?
  technicalProfile Json?
  accessInstructions String?
  accessInfo       Json?
  consumption      Json?       // { [propertyProductId]: quantita' consumata al check-in }
  createdAt        DateTime    @default(now())
  units            Apartment[]

  @@index([propertyId])
}

model User {
  id                   String                @id @default(uuid())
  email                String                @unique
  password             String
  role                 Role
  createdAt            DateTime              @default(now())
  name                 String
  phone                String?
  address              String?
  isExternal           Boolean               @default(false)
  companyName          String?
  vatNumber            String?
  iban                 String?
  organizationId       String?
  notificationPrefs    Json?
  failedLoginCount     Int                   @default(0)
  lockedUntil          DateTime?
  privacyAcceptedAt    DateTime?
  companyId            String?
  company              Company?              @relation(fields: [companyId], references: [id], onDelete: SetNull)
  organization         Organization?         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cleaningTasks        CleaningTask[]
  maintenanceTickets   MaintenanceTicket[]
  supervisorReviews    SupervisorReview[]    @relation("SupervisorReviews")
  supervisedApartments ApartmentSupervisor[]
  ownedApartments      ApartmentOwner[]
  pushSubscriptions    PushSubscription[]
  apnsTokens           ApnsToken[]
  fcmTokens            FcmToken[]
  cleanerLocation      CleanerLocation?
  checkinTasks         CheckinTask[]

  @@index([organizationId])
  @@index([companyId])
}

// Chat org ↔ impresa: un thread per (org, company). Visibile solo ai manager
// dell'organizzazione e al manager dell'impresa. Manager-to-manager.
model OrgCompanyMessage {
  id               String       @id @default(uuid())
  organizationId   String
  companyId        String
  senderIsOrg      Boolean
  senderName       String
  text             String
  mediaUrl         String?
  mediaType        String?
  mediaName        String?
  createdAt        DateTime     @default(now())
  readByOrgAt      DateTime?
  readByCompanyAt  DateTime?
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company          Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([organizationId, companyId, createdAt])
}

// Chat privata dell'impresa: un thread per (impresa, operatore). Visibile solo
// al manager d'impresa e all'operatore stesso; MAI al proprietario.
model CompanyChatMessage {
  id              String   @id @default(uuid())
  companyId       String
  staffUserId     String
  senderIsManager Boolean
  text            String
  mediaUrl        String?
  mediaType       String?  // image | audio | file (categoria) o mime
  mediaName       String?
  createdAt       DateTime @default(now())
  readByManagerAt DateTime?
  readByStaffAt   DateTime?

  @@index([companyId, staffUserId, createdAt])
}

// Impresa esterna indipendente (pulizie/manutenzione/check-in/supervisione).
// Non e' figlia di una singola Organization: viene ingaggiata (Engagement) da
// una o piu' organizzazioni, e puo' coprire piu' funzioni.
model Company {
  id                String             @id @default(uuid())
  name              String
  slug              String             @unique
  legalName         String?
  vatNumber         String?
  scopes            String[]           @default([]) // funzioni offerte: CLEANING|MAINTENANCE|CHECKIN|SUPERVISION
  createdAt         DateTime           @default(now())
  users             User[]
  engagements       Engagement[]
  warehouseProducts WarehouseProduct[]
  orgMessages       OrgCompanyMessage[]
}

// Ingaggio: un proprietario (Organization) delega UNA funzione (scope) a una
// Company. Consenso e revoca sono del proprietario.
model Engagement {
  id             String                @id @default(uuid())
  organizationId String
  companyId      String
  scope          String                // CLEANING | MAINTENANCE | CHECKIN | SUPERVISION
  status         String                @default("PENDING") // PENDING | ACTIVE | REVOKED
  invitedAt      DateTime              @default(now())
  acceptedAt     DateTime?
  revokedAt      DateTime?
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company        Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  apartments     EngagementApartment[]

  @@unique([organizationId, companyId, scope])
  @@index([companyId])
  @@index([organizationId])
}

model EngagementApartment {
  engagementId String
  apartmentId  String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  apartment    Apartment  @relation(fields: [apartmentId], references: [id], onDelete: Cascade)

  @@id([engagementId, apartmentId])
  @@index([apartmentId])
}

model Apartment {
  id                   String                @id @default(uuid())
  name                 String
  apartmentCode        String?               @unique
  organizationId       String?
  organization         Organization?         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  address              String
  latitude             Float
  longitude            Float
  squareMeters         Int
  bedrooms             Int
  bathrooms            Int
  maxGuests            Int
  accessInstructions   String?
  accessInfo           Json?
  bedConfig            Json?
  icalUrl              String?
  lastSyncAt           DateTime?
  technicalProfile     Json?
  checkinDefaultTime   String?
  autoCheckin          Boolean               @default(false)
  createdAt            DateTime              @default(now())
  clientId             String?
  client               Client?               @relation(fields: [clientId], references: [id], onDelete: SetNull)
  propertyId           String?
  property             Property?             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitCategoryId       String?
  unitCategory         UnitCategory?         @relation(fields: [unitCategoryId], references: [id], onDelete: SetNull)
  unitNumber           String?
  bookings             Booking[]
  checklistItems       ChecklistItem[]
  cleaningTasks        CleaningTask[]
  maintenanceTickets   MaintenanceTicket[]
  notifications        Notification[]
  aiAssistantMessages  AIAssistantMessage[]
  apartmentAttachments ApartmentAttachment[]
  supervisors          ApartmentSupervisor[]
  owners               ApartmentOwner[]
  products             ApartmentProduct[]
  checkinChecklistItems CheckinChecklistItem[]
  checkinTasks         CheckinTask[]
  engagements          EngagementApartment[]

  @@index([organizationId])
  @@index([propertyId])
  @@index([unitCategoryId])
}

model ChecklistItem {
  id                 String    @id @default(uuid())
  apartmentId        String
  label              String
  labelTranslations  Json?
  required           Boolean   @default(true)
  photoRequired      Boolean   @default(false)
  phase              String    @default("cleaning")
  answerType         String    @default("check")
  order         Int       @default(0)
  createdAt     DateTime  @default(now())
  formula       String?
  type          String    @default("static")
  apartment     Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String     @id @default(uuid())
  type        String
  title       String
  message     String
  isRead      Boolean    @default(false)
  readAt      DateTime?
  createdAt   DateTime   @default(now())
  apartmentId String?
  apartment   Apartment? @relation(fields: [apartmentId], references: [id])
}

model Booking {
  id           String        @id @default(uuid())
  apartmentId  String
  guestName    String?
  totalGuests  Int
  checkInDate  DateTime
  checkOutDate DateTime
  status           String?
  externalId       String?       @unique
  source           String?
  cullaRequested   Boolean       @default(false)
  productsConsumedAt DateTime?
  createdAt        DateTime      @default(now())
  apartment    Apartment     @relation(fields: [apartmentId], references: [id])
  cleaningTask CleaningTask?
  checkinTask  CheckinTask?
}

model CleaningTask {
  id                  String                @id @default(uuid())
  apartmentId         String
  date                DateTime
  status              String
  createdAt           DateTime              @default(now())
  startedAt           DateTime?
  completedAt         DateTime?
  productsConsumedAt  DateTime?
  skipProductConsumption Boolean            @default(false)
  assignedToId        String?
  notes               String?
  bookingId           String?               @unique
  booking             Booking?              @relation(fields: [bookingId], references: [id])
  checklistProgress   Json?                 @default("[]")
  correctionProgress  Json?
  cleaningAccessToken String?               @unique
  cleaningAccessTokenExpiresAt DateTime?
  cullaRequested      Boolean               @default(false)
  sofaBedForced       Boolean               @default(false)
  totalGuests         Int?
  apartment           Apartment             @relation(fields: [apartmentId], references: [id])
  assignedTo          User?                 @relation(fields: [assignedToId], references: [id])
  messages            CleaningTaskMessage[]
  attachments         Attachment[]
  aiAssistantMessages AIAssistantMessage[]
  supervisorReviews   SupervisorReview[]
}

// Voce della checklist di CHECK-IN, per-appartamento. Modello separato dalle
// pulizie (ChecklistItem) per isolamento totale tra le due liste.
model CheckinChecklistItem {
  id                 String    @id @default(uuid())
  apartmentId        String
  label              String
  labelTranslations  Json?
  required           Boolean   @default(true)
  photoRequired      Boolean   @default(false)
  order              Int       @default(0)
  createdAt          DateTime  @default(now())
  type               String    @default("static")
  apartment          Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
}

// Task operativa di CHECK-IN, gemella di CleaningTask ma agganciata alla data
// di check-in della prenotazione. Auto-creata da ogni prenotazione.
model CheckinTask {
  id                 String    @id @default(uuid())
  apartmentId        String
  date               DateTime
  status             String
  createdAt          DateTime  @default(now())
  startedAt          DateTime?
  completedAt        DateTime?
  assignedToId       String?
  notes              String?
  bookingId          String?   @unique
  booking            Booking?  @relation(fields: [bookingId], references: [id])
  checklistProgress  Json?     @default("[]")
  checkinAccessToken String?   @unique
  checkinAccessTokenExpiresAt DateTime?
  apartment          Apartment @relation(fields: [apartmentId], references: [id])
  assignedTo         User?     @relation(fields: [assignedToId], references: [id])
  messages           CheckinTaskMessage[]
  attachments        Attachment[]
}

model CheckinTaskMessage {
  id              String      @id @default(uuid())
  text            String?
  role            String
  senderName      String
  createdAt       DateTime    @default(now())
  checkinTaskId   String
  checkinTask     CheckinTask @relation(fields: [checkinTaskId], references: [id], onDelete: Cascade)
  attachmentId    String?
  attachment      Attachment? @relation(fields: [attachmentId], references: [id])
  readByManagerAt DateTime?
  readByWorkerAt  DateTime?
}

model MaintenanceTicket {
  id                        String               @id @default(uuid())
  apartmentId               String
  title                     String
  description               String
  status                    String
  priority                  String
  createdAt                 DateTime             @default(now())
  assignedToId              String?
  scheduledStart            DateTime?
  scheduledEnd              DateTime?
  startedAt                 DateTime?
  resolvedAt                DateTime?
  correctionProgress        Json?
  maintenanceTasks          Json?
  maintenanceAccessToken    String?              @unique
  maintenanceAccessTokenExpiresAt DateTime?
  apartment                 Apartment            @relation(fields: [apartmentId], references: [id])
  assignedTo                User?                @relation(fields: [assignedToId], references: [id])
  attachments               Attachment[]
  messages                  Message[]
  aiAssistantMessages       AIAssistantMessage[]
  supervisorReviews         SupervisorReview[]
}

model AIAssistantMessage {
  id                  String                 @id @default(uuid())
  role                AIAssistantMessageRole
  content             String
  userRole            Role
  apartmentId         String?
  cleaningTaskId      String?
  maintenanceTicketId String?
  createdAt           DateTime               @default(now())
  apartment           Apartment?             @relation(fields: [apartmentId], references: [id], onDelete: SetNull)
  cleaningTask        CleaningTask?          @relation(fields: [cleaningTaskId], references: [id], onDelete: Cascade)
  maintenanceTicket   MaintenanceTicket?     @relation(fields: [maintenanceTicketId], references: [id], onDelete: Cascade)

  @@index([apartmentId])
  @@index([cleaningTaskId])
  @@index([maintenanceTicketId])
  @@index([createdAt])
}

model Attachment {
  id                  String                @id @default(uuid())
  url                 String
  fileName            String                @default("attachment")
  fileType            String?
  size                Int?
  category            String                @default("OTHER")
  extractedText       String?
  createdAt           DateTime              @default(now())
  maintenanceTicketId String?
  maintenanceTicket   MaintenanceTicket?    @relation(fields: [maintenanceTicketId], references: [id], onDelete: Cascade)
  cleaningTaskId      String?
  cleaningTask        CleaningTask?         @relation(fields: [cleaningTaskId], references: [id], onDelete: Cascade)
  checkinTaskId       String?
  checkinTask         CheckinTask?          @relation(fields: [checkinTaskId], references: [id], onDelete: Cascade)
  messages            Message[]
  cleaningMessages    CleaningTaskMessage[]
  checkinMessages     CheckinTaskMessage[]

  @@index([maintenanceTicketId])
  @@index([cleaningTaskId])
  @@index([checkinTaskId])
  @@index([category])
}

model ApartmentAttachment {
  id            String    @id @default(uuid())
  apartmentId   String
  apartment     Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  filename      String
  url           String?
  mimeType      String?
  size          Int?
  category      String    @default("OTHER")
  linkedTo      String?
  extractedText String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([apartmentId])
  @@index([category])
}

model Message {
  id                  String            @id @default(uuid())
  text                String?
  role                String
  senderName          String
  createdAt           DateTime          @default(now())
  maintenanceTicketId String
  maintenanceTicket   MaintenanceTicket @relation(fields: [maintenanceTicketId], references: [id], onDelete: Cascade)
  attachmentId        String?
  attachment          Attachment?       @relation(fields: [attachmentId], references: [id])
  readByManagerAt     DateTime?
  readByWorkerAt      DateTime?
}

model CleaningTaskMessage {
  id              String       @id @default(uuid())
  text            String?
  role            String
  senderName      String
  createdAt       DateTime     @default(now())
  cleaningTaskId  String
  cleaningTask    CleaningTask @relation(fields: [cleaningTaskId], references: [id], onDelete: Cascade)
  attachmentId    String?
  attachment      Attachment?  @relation(fields: [attachmentId], references: [id])
  readByManagerAt DateTime?
  readByWorkerAt  DateTime?
}

model SupervisorReview {
  id                  String             @id @default(uuid())
  supervisorId        String
  supervisor          User               @relation("SupervisorReviews", fields: [supervisorId], references: [id])
  cleaningTaskId      String?
  cleaningTask        CleaningTask?      @relation(fields: [cleaningTaskId], references: [id], onDelete: Cascade)
  maintenanceTicketId String?
  maintenanceTicket   MaintenanceTicket? @relation(fields: [maintenanceTicketId], references: [id], onDelete: Cascade)
  decision            String
  notes               String?
  correctionItems     Json?
  createdAt           DateTime           @default(now())

  @@index([cleaningTaskId])
  @@index([maintenanceTicketId])
  @@index([supervisorId])
}

model ApartmentSupervisor {
  apartmentId String
  userId      String
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([apartmentId, userId])
}

// Anagrafica clienti/proprietari per la fatturazione (privato o impresa).
// Org-scoped. Un cliente può avere più appartamenti; ogni appartamento ha
// al massimo un cliente (Apartment.clientId).
model Client {
  id             String      @id @default(uuid())
  organizationId String
  type           String      @default("PRIVATE") // PRIVATE | COMPANY
  name           String      // ragione sociale (impresa) o nome e cognome (privato)
  vatNumber      String?     // partita IVA
  taxCode        String?     // codice fiscale
  sdiCode        String?     // codice destinatario SDI
  pec            String?
  email          String?
  phone          String?
  address        String?
  city           String?
  zip            String?
  province       String?
  country        String?     @default("Italia")
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  apartments     Apartment[]

  @@index([organizationId])
}

model ApartmentOwner {
  apartmentId String
  userId      String
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([apartmentId, userId])
}

model ManagerChatSession {
  id             String               @id @default(uuid())
  date           DateTime             @db.Date
  createdAt      DateTime             @default(now())
  organizationId String?
  organization   Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages       ManagerChatMessage[]

  @@unique([date, organizationId])
  @@index([organizationId])
}

model ManagerChatMessage {
  id        String             @id @default(uuid())
  sessionId String
  session   ManagerChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime           @default(now())

  @@index([sessionId])
}

enum Role {
  MANAGER
  CLEANER
  MAINTENANCE
  SUPERVISOR
  OWNER
  CHECKIN
}

enum AIAssistantMessageRole {
  USER
  ASSISTANT
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model ApnsToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  createdAt DateTime @default(now())

  @@index([userId])
}

model FcmToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  createdAt DateTime @default(now())

  @@index([userId])
}

model CleanerLocation {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  latitude    Float
  longitude   Float
  accuracy    Float?
  updatedAt   DateTime @updatedAt
}

model SuperAdminLog {
  id        String   @id @default(cuid())
  action    String
  detail    String?
  orgId     String?
  orgName   String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([orgId])
}

model ApartmentProduct {
  id               String    @id @default(uuid())
  apartmentId      String
  apartment        Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  name             String
  emoji            String    @default("📦")
  unit             String    @default("pz")
  stock            Int       @default(0)
  minStock         Int       @default(0)
  consumptionType  String    @default("STATIC")
  consumptionValue Float     @default(1)
  price            Float     @default(0) // prezzo per unità (imponibile)
  vat              Float     @default(22) // aliquota IVA in %
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  movements        StockMovement[]

  @@index([apartmentId])
}

// Registro movimenti di scorta: una riga per ogni variazione (consumo al
// check-in, rifornimento, rettifica manuale, valore iniziale). Consente lo
// storico per intervallo di date (quantità iniziale/finale + dettaglio).
model StockMovement {
  id        String           @id @default(uuid())
  productId String
  product   ApartmentProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  delta     Int              // variazione (negativa = consumo, positiva = carico)
  balance   Int              // saldo risultante dopo questo movimento
  reason    String           // INITIAL | CHECKIN | RESTOCK | ADJUSTMENT
  bookingId String?          // riferimento prenotazione (per i consumi da check-in)
  note      String?          // etichetta leggibile (es. nome ospite)
  createdAt DateTime         @default(now())

  @@index([productId, createdAt])
}

// Prodotto di MAGAZZINO: scorta generica a livello di organizzazione (non legata
// a un singolo appartamento). Es. impresa di pulizie con materiale di consumo.
// Consumo: MANUAL (solo "Preleva"), STATIC (fisso per check-in), DYNAMIC
// (valore × base BATHROOM/GUEST/BEDROOM per ogni check-in del giorno).
model WarehouseProduct {
  id               String   @id @default(uuid())
  organizationId   String?  // proprietario = Organization OPPURE Company (uno solo)
  companyId        String?
  name             String
  emoji            String   @default("📦")
  unit             String   @default("pz")
  stock            Int      @default(0)
  minStock         Int      @default(0)
  consumptionType  String   @default("MANUAL")   // MANUAL | STATIC | DYNAMIC
  consumptionBasis String   @default("BATHROOM") // usato solo se DYNAMIC: BATHROOM | GUEST | BEDROOM
  consumptionValue Float    @default(1)
  price            Float    @default(0) // prezzo per unità (imponibile)
  vat              Float    @default(22) // aliquota IVA in %
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company          Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  movements        WarehouseStockMovement[]

  @@index([organizationId])
  @@index([companyId])
}

// Registro movimenti del magazzino (analogo a StockMovement per gli appartamenti).
model WarehouseStockMovement {
  id        String           @id @default(uuid())
  productId String
  product   WarehouseProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  delta     Int
  balance   Int
  reason    String           // INITIAL | CHECKIN | RESTOCK | ADJUSTMENT | USAGE
  bookingId String?
  note      String?
  createdAt DateTime         @default(now())

  @@index([productId, createdAt])
}
