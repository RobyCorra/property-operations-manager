generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                        String       @id @default(cuid())
  name                      String
  slug                      String       @unique
  logoUrl                   String?
  legalName                 String?
  vatNumber                 String?
  fiscalCode                String?
  address                   String?
  city                      String?
  zip                       String?
  country                   String?
  phone                     String?
  email                     String?
  pec                       String?
  sdiCode                   String?
  aiMonthlyTokenLimit       Int          @default(1800000)
  aiTokensUsed              Int          @default(0)
  aiTokensResetAt           DateTime?
  perplexityMonthlyLimit    Int          @default(600)
  perplexityRequestsUsed    Int          @default(0)
  perplexityRequestsResetAt DateTime?
  createdAt                 DateTime     @default(now())
  users        User[]
  apartments   Apartment[]
  chatSessions ManagerChatSession[]
}

model User {
  id                   String                @id @default(uuid())
  email                String                @unique
  password             String
  role                 Role
  createdAt            DateTime              @default(now())
  name                 String
  phone                String?
  address              String?
  isExternal           Boolean               @default(false)
  companyName          String?
  vatNumber            String?
  iban                 String?
  organizationId       String?
  notificationPrefs    Json?
  organization         Organization?         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cleaningTasks        CleaningTask[]
  maintenanceTickets   MaintenanceTicket[]
  supervisorReviews    SupervisorReview[]    @relation("SupervisorReviews")
  supervisedApartments ApartmentSupervisor[]
  ownedApartments      ApartmentOwner[]
  pushSubscriptions    PushSubscription[]
  apnsTokens           ApnsToken[]

  @@index([organizationId])
}

model Apartment {
  id                   String                @id @default(uuid())
  name                 String
  apartmentCode        String?               @unique
  organizationId       String?
  organization         Organization?         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  address              String
  latitude             Float
  longitude            Float
  squareMeters         Int
  bedrooms             Int
  bathrooms            Int
  maxGuests            Int
  accessInstructions   String?
  accessInfo           Json?
  bedConfig            Json?
  icalUrl              String?
  lastSyncAt           DateTime?
  technicalProfile     Json?
  createdAt            DateTime              @default(now())
  bookings             Booking[]
  checklistItems       ChecklistItem[]
  cleaningTasks        CleaningTask[]
  maintenanceTickets   MaintenanceTicket[]
  notifications        Notification[]
  aiAssistantMessages  AIAssistantMessage[]
  apartmentAttachments ApartmentAttachment[]
  supervisors          ApartmentSupervisor[]
  owners               ApartmentOwner[]
  products             ApartmentProduct[]

  @@index([organizationId])
}

model ChecklistItem {
  id                 String    @id @default(uuid())
  apartmentId        String
  label              String
  labelTranslations  Json?
  required           Boolean   @default(true)
  photoRequired      Boolean   @default(false)
  order         Int       @default(0)
  createdAt     DateTime  @default(now())
  formula       String?
  type          String    @default("static")
  apartment     Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String     @id @default(uuid())
  type        String
  title       String
  message     String
  isRead      Boolean    @default(false)
  readAt      DateTime?
  createdAt   DateTime   @default(now())
  apartmentId String?
  apartment   Apartment? @relation(fields: [apartmentId], references: [id])
}

model Booking {
  id           String        @id @default(uuid())
  apartmentId  String
  guestName    String?
  totalGuests  Int
  checkInDate  DateTime
  checkOutDate DateTime
  status           String?
  externalId       String?       @unique
  source           String?
  cullaRequested   Boolean       @default(false)
  createdAt        DateTime      @default(now())
  apartment    Apartment     @relation(fields: [apartmentId], references: [id])
  cleaningTask CleaningTask?
}

model CleaningTask {
  id                  String                @id @default(uuid())
  apartmentId         String
  date                DateTime
  status              String
  createdAt           DateTime              @default(now())
  startedAt           DateTime?
  completedAt         DateTime?
  assignedToId        String?
  notes               String?
  bookingId           String?               @unique
  booking             Booking?              @relation(fields: [bookingId], references: [id])
  checklistProgress   Json?                 @default("[]")
  correctionProgress  Json?
  cleaningAccessToken String?               @unique
  apartment           Apartment             @relation(fields: [apartmentId], references: [id])
  assignedTo          User?                 @relation(fields: [assignedToId], references: [id])
  messages            CleaningTaskMessage[]
  attachments         Attachment[]
  aiAssistantMessages AIAssistantMessage[]
  supervisorReviews   SupervisorReview[]
}

model MaintenanceTicket {
  id                        String               @id @default(uuid())
  apartmentId               String
  title                     String
  description               String
  status                    String
  priority                  String
  createdAt                 DateTime             @default(now())
  assignedToId              String?
  scheduledStart            DateTime?
  scheduledEnd              DateTime?
  startedAt                 DateTime?
  resolvedAt                DateTime?
  correctionProgress        Json?
  maintenanceTasks          Json?
  maintenanceAccessToken    String?              @unique
  apartment                 Apartment            @relation(fields: [apartmentId], references: [id])
  assignedTo                User?                @relation(fields: [assignedToId], references: [id])
  attachments               Attachment[]
  messages                  Message[]
  aiAssistantMessages       AIAssistantMessage[]
  supervisorReviews         SupervisorReview[]
}

model AIAssistantMessage {
  id                  String                 @id @default(uuid())
  role                AIAssistantMessageRole
  content             String
  userRole            Role
  apartmentId         String?
  cleaningTaskId      String?
  maintenanceTicketId String?
  createdAt           DateTime               @default(now())
  apartment           Apartment?             @relation(fields: [apartmentId], references: [id], onDelete: SetNull)
  cleaningTask        CleaningTask?          @relation(fields: [cleaningTaskId], references: [id], onDelete: Cascade)
  maintenanceTicket   MaintenanceTicket?     @relation(fields: [maintenanceTicketId], references: [id], onDelete: Cascade)

  @@index([apartmentId])
  @@index([cleaningTaskId])
  @@index([maintenanceTicketId])
  @@index([createdAt])
}

model Attachment {
  id                  String                @id @default(uuid())
  url                 String
  fileName            String                @default("attachment")
  fileType            String?
  size                Int?
  category            String                @default("OTHER")
  extractedText       String?
  createdAt           DateTime              @default(now())
  maintenanceTicketId String?
  maintenanceTicket   MaintenanceTicket?    @relation(fields: [maintenanceTicketId], references: [id], onDelete: Cascade)
  cleaningTaskId      String?
  cleaningTask        CleaningTask?         @relation(fields: [cleaningTaskId], references: [id], onDelete: Cascade)
  messages            Message[]
  cleaningMessages    CleaningTaskMessage[]

  @@index([maintenanceTicketId])
  @@index([cleaningTaskId])
  @@index([category])
}

model ApartmentAttachment {
  id            String    @id @default(uuid())
  apartmentId   String
  apartment     Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  filename      String
  url           String?
  mimeType      String?
  size          Int?
  category      String    @default("OTHER")
  linkedTo      String?
  extractedText String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([apartmentId])
  @@index([category])
}

model Message {
  id                  String            @id @default(uuid())
  text                String?
  role                String
  senderName          String
  createdAt           DateTime          @default(now())
  maintenanceTicketId String
  maintenanceTicket   MaintenanceTicket @relation(fields: [maintenanceTicketId], references: [id], onDelete: Cascade)
  attachmentId        String?
  attachment          Attachment?       @relation(fields: [attachmentId], references: [id])
  readByManagerAt     DateTime?
  readByWorkerAt      DateTime?
}

model CleaningTaskMessage {
  id              String       @id @default(uuid())
  text            String?
  role            String
  senderName      String
  createdAt       DateTime     @default(now())
  cleaningTaskId  String
  cleaningTask    CleaningTask @relation(fields: [cleaningTaskId], references: [id], onDelete: Cascade)
  attachmentId    String?
  attachment      Attachment?  @relation(fields: [attachmentId], references: [id])
  readByManagerAt DateTime?
  readByWorkerAt  DateTime?
}

model SupervisorReview {
  id                  String             @id @default(uuid())
  supervisorId        String
  supervisor          User               @relation("SupervisorReviews", fields: [supervisorId], references: [id])
  cleaningTaskId      String?
  cleaningTask        CleaningTask?      @relation(fields: [cleaningTaskId], references: [id], onDelete: Cascade)
  maintenanceTicketId String?
  maintenanceTicket   MaintenanceTicket? @relation(fields: [maintenanceTicketId], references: [id], onDelete: Cascade)
  decision            String
  notes               String?
  correctionItems     Json?
  createdAt           DateTime           @default(now())

  @@index([cleaningTaskId])
  @@index([maintenanceTicketId])
  @@index([supervisorId])
}

model ApartmentSupervisor {
  apartmentId String
  userId      String
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([apartmentId, userId])
}

model ApartmentOwner {
  apartmentId String
  userId      String
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([apartmentId, userId])
}

model ManagerChatSession {
  id             String               @id @default(uuid())
  date           DateTime             @db.Date
  createdAt      DateTime             @default(now())
  organizationId String?
  organization   Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages       ManagerChatMessage[]

  @@unique([date, organizationId])
  @@index([organizationId])
}

model ManagerChatMessage {
  id        String             @id @default(uuid())
  sessionId String
  session   ManagerChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime           @default(now())

  @@index([sessionId])
}

enum Role {
  MANAGER
  CLEANER
  MAINTENANCE
  SUPERVISOR
  OWNER
}

enum AIAssistantMessageRole {
  USER
  ASSISTANT
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model ApnsToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  createdAt DateTime @default(now())

  @@index([userId])
}

model SuperAdminLog {
  id        String   @id @default(cuid())
  action    String
  detail    String?
  orgId     String?
  orgName   String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([orgId])
}

model ApartmentProduct {
  id               String    @id @default(uuid())
  apartmentId      String
  apartment        Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  name             String
  emoji            String    @default("📦")
  unit             String    @default("pz")
  stock            Int       @default(0)
  minStock         Int       @default(0)
  consumptionType  String    @default("STATIC")
  consumptionValue Float     @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([apartmentId])
}
